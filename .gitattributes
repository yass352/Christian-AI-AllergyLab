# Fichiers texte : git les range avec des fins de ligne LF, sur les trois systèmes.
* text=auto eol=lf

# Les fichiers de donnees/ sont ceux que leur éditeur a publiés.
# binary : git ne convertit jamais leurs fins de ligne, sinon leur empreinte change.
donnees/** binary

# La table inventée garde les conventions du fichier réel (BOM, fins de ligne CRLF).
kit/exemple/*.csv -text
